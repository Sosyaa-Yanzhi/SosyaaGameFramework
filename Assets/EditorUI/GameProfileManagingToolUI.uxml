<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="GameProfileManagingTool" style="flex-grow: 1; flex-direction: column;">
        <ui:Label tabindex="-1" text="游戏存档编辑器" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ToolTitile" enable-rich-text="true" style="-unity-font-style: bold; -unity-font: initial; font-size: 19px; color: rgb(255, 255, 255); -unity-text-align: upper-left; white-space: nowrap; -unity-text-outline-width: 0; background-color: rgba(5, 206, 29, 0.21); border-left-color: rgb(0, 159, 20); border-right-color: rgb(0, 159, 20); border-top-color: rgb(0, 159, 20); border-bottom-color: rgb(0, 159, 20); border-top-width: 0; border-bottom-width: 1px; border-top-left-radius: 1px; border-top-right-radius: 1px; border-bottom-right-radius: 1px; border-bottom-left-radius: 1px;" />
        <ui:VisualElement name="visualelment-profileviewer" style="flex-grow: 1; height: 168px;">
            <ui:Label tabindex="-1" text="存档文件目录结构" parse-escape-sequences="true" display-tooltip-when-elided="true" name="label-filestructure" style="color: rgb(255, 255, 255); background-color: rgba(255, 216, 0, 0.27); border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 0; border-bottom-left-radius: 0;" />
            <uie:ObjectField label="存档根文件" name="objectfield-rootfile" style="height: 52px; background-color: rgb(99, 99, 99); -unity-background-scale-mode: scale-and-crop; transform-origin: left top; scale: 1 1;" />
            <ui:TreeView fixed-item-height="22" virtualization-method="FixedHeight" show-border="true" auto-expand="false" horizontal-scrolling="false" name="treeview-filestructure" style="height: auto; scale: 1 0.5; transform-origin: top;" />
            <ui:Label tabindex="-1" text="现有存档数据" parse-escape-sequences="true" display-tooltip-when-elided="true" name="label-profileviewertitle" style="color: rgb(255, 255, 255); background-color: rgba(255, 216, 0, 0.27); -unity-text-align: upper-left; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 0; border-bottom-left-radius: 0; top: auto; position: relative;" />
            <ui:ListView name="listview-gameprofiledatas" virtualization-method="DynamicHeight" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
