<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="viualElement-dialogtitle" style="flex-grow: 1; background-color: rgba(35, 255, 0, 0.55); border-bottom-color: rgb(2, 132, 18); border-bottom-width: 3px; height: 24px; min-height: 0; max-height: 29px;">
        <ui:Label tabindex="-1" text="添加存档数据表" parse-escape-sequences="true" display-tooltip-when-elided="true" name="label_dialogtitle" style="color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 20px; -unity-text-align: middle-left;" />
    </ui:VisualElement>
    <ui:VisualElement name="visualelement-rootelement" style="flex-grow: 1; background-color: rgba(75, 74, 74, 0); width: 345px; color: rgba(27, 27, 27, 0); height: 85px; max-height: 121px;">
        <ui:EnumField label="存档数据类型" type="UnityEngine.TextAlignment, UnityEngine.TextRenderingModule" value="Center" name="enumfield-profiletype" style="-unity-font-style: bold; font-size: 20px; background-color: rgb(89, 89, 89); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; transform-origin: left top; scale: 0.8 0.8; color: rgb(255, 255, 255); -unity-text-align: middle-center; height: 35px;" />
        <ui:TextField picking-mode="Ignore" label="数据表名称" value="filler text" name="textfield-profilemapname" style="width: 284px; background-color: rgb(89, 89, 89); color: rgb(255, 255, 255); -unity-font-style: bold; height: 35px; align-self: flex-start; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; transform-origin: left top; scale: 0.8 0.8; font-size: 20px; -unity-font: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); -unity-text-align: middle-center; white-space: nowrap;" />
        <ui:TextField picking-mode="Ignore" label="目标路径" value="filler text" name="textfield-profiletargetpath" style="width: 284px; background-color: rgb(89, 89, 89); color: rgb(255, 255, 255); -unity-font-style: bold; height: 35px; align-self: flex-start; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; transform-origin: left top; scale: 0.8 0.8; -unity-text-align: middle-center; font-size: 20px;" />
    </ui:VisualElement>
    <ui:VisualElement name="visualelement-dialogbutton" style="flex-grow: 1; flex-direction: row; height: 47px; max-height: 36px; top: 5px; margin-bottom: 11px;">
        <ui:Button text="确认添加" parse-escape-sequences="true" display-tooltip-when-elided="true" name="button-addconfirm" style="width: 90px; height: 20px; color: rgb(255, 255, 255); -unity-font-style: bold; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; -unity-text-outline-color: rgb(255, 255, 255); background-color: rgb(81, 81, 81); top: 13px;" />
        <ui:Button text="取消" parse-escape-sequences="true" display-tooltip-when-elided="true" name="button-cancel" style="width: 90px; height: 20px; color: rgb(255, 255, 255); -unity-font-style: bold; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; background-color: rgb(81, 81, 81); top: 13px;" />
    </ui:VisualElement>
</ui:UXML>
