<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="visualelement-rootelement" style="flex-grow: 1; background-color: rgba(75, 74, 74, 0); width: 345px; color: rgba(27, 27, 27, 0); height: 85px; max-height: 121px;">
        <ui:EnumField label="存档数据类型" type="UnityEngine.TextAlignment, UnityEngine.TextRenderingModule" value="Center" name="enumfield-profiletype" style="-unity-font-style: bold; font-size: 14px; background-color: rgb(89, 89, 89); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; transform-origin: left top; scale: 0.8 0.8; color: rgb(255, 255, 255);" />
        <ui:TextField picking-mode="Ignore" label="数据表名称" value="filler text" name="textfield-profilemapname" style="width: 284px; background-color: rgb(89, 89, 89); color: rgb(255, 255, 255); -unity-font-style: bold; height: 36px; align-self: flex-start; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; transform-origin: left top; scale: 0.8 0.8;" />
        <ui:TextField picking-mode="Ignore" label="目标路径" value="filler text" name="textfield-profiletargetpath" style="width: 284px; background-color: rgb(89, 89, 89); color: rgb(255, 255, 255); -unity-font-style: bold; height: 36px; align-self: flex-start; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; transform-origin: left top; scale: 0.8 0.8;" />
    </ui:VisualElement>
    <ui:VisualElement name="visualelement-dialogbutton" style="flex-grow: 1; flex-direction: row; height: 47px; max-height: 36px;">
        <ui:Button text="确认添加" parse-escape-sequences="true" display-tooltip-when-elided="true" name="button-addconfirm" style="width: 122px; height: 33px; color: rgb(27, 27, 27); -unity-font-style: bold; border-top-left-radius: 19px; border-top-right-radius: 19px; border-bottom-right-radius: 19px; border-bottom-left-radius: 19px;" />
        <ui:Button text="取消" parse-escape-sequences="true" display-tooltip-when-elided="true" name="button-cancel" style="width: 122px; height: 33px; color: rgb(27, 27, 27); -unity-font-style: bold; border-top-left-radius: 19px; border-top-right-radius: 19px; border-bottom-right-radius: 19px; border-bottom-left-radius: 19px;" />
    </ui:VisualElement>
</ui:UXML>
